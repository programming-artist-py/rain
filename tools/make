# rain make tool, rmt.
import argparse
import os
import subprocess
import sys
import shutil

to_write = """this is a rain project created using the Rain Make Tool *RMT.
to compile this project, use the Rain Build Tool *RBT.
to run without compiling this project, use the Rain Run Tool *RRT.

RMT:

rainc make <project_name>

RBT:

rainc build [-c/--clean] -o/--output <output_file_name> <input_file_name> (for building only one file)
rainc build [-c/--clean] -m/--multiple -o/--output <output_file_name> "{<input_filename_a>, <input_filename_b>, <input_filename_c>}" (for building with multiple files)
rainc build --clear (clears build and dist folder)

RRT:

rainc run <file_name> (RRT can only run 1 file.)

TASKS:

RBT and RRT can be automated, from 0.4.5 onwards, you will see rain.bat and rain.cnf inside of RMT projects.

rain.bat is a task automater, it parses rain.cnf and allows you to simple run ./rain.bat run or ./rain.bat build
instead of rerunning the same long commandlet

rain.cnf is a config file for rain.bat, it has two values that must be defined: run_options and build_options,
any other value defined in it is treated as a variable that you can use inside of run_options and build_options.
the default run and build options look like so:

build_options = ("-i rainc/incl/INCLUDE","-o main.rain", starting_file)
run_options = (starting_file,"-i rainc/incl/INCLUDE")

build_options just has -i GLOBALINCLUDEFILE then output file of main.exe and starting_file as file (defined as main.rain earlier)

run options just runs the starting_file (main.rain) with the GLOBALINCLUDEFILE

please note: any spaces inside of any variable, whether outside or inside strings won't be removed so separate things with only a comma and no space within
build and run options"""

main_rain = """:@maketool {
   PRINT 'Made by Rain Make Tool'
}
@maketool:
"""

rain_cnf = """starting_file = "main.rain"

build_options = ("-i rainc/incl/INCLUDE","-o main.exe",starting_file)
run_options = (starting_file,"-i rainc/incl/INCLUDE")"""

rain_bat = """@echo off
setlocal enabledelayedexpansion

set "CNF_FILE=rain.cnf"

if not exist "%CNF_FILE%" (
    echo Config file "%CNF_FILE%" not found!
    exit /b 1
)

REM === Parse all key=value pairs ===
for /f "usebackq tokens=1,* delims== " %%A in ("%CNF_FILE%") do (
    set "key=%%~A"
    set "value=%%~B"
    REM remove quotes and spaces around it
    set "value=!value:"=!"
    REM Store it as variable
    set "!key!=!value!"
)

REM === Cleanup formatting for any options ===
for %%V in (build_options run_options) do (
    set "line=!%%V!"
    set "line=!line:(=!"
    set "line=!line:)=!"
    set "line=!line:'='!"
    REM Replace commas with spaces
    set "line=!line:,= !"
    REM Expand starting_file variable if referenced
    call set "line=%%line:starting_file=%starting_file%%%"
    set "%%V=!line!"
)

REM === Choose action ===
set "action=%~1"

if "%action%"=="" (
    echo Usage: %~n0 [run^|build]
    exit /b 1
)

if /i "%action%"=="run" (
    echo Running: rainc run %run_options%
    rainc run %run_options%
    exit /b
)

if /i "%action%"=="build" (
    echo Building: rainc build %build_options%
    rainc build %build_options%
    exit /b
)

echo Unknown command "%action%".
echo Usage: %~n0 [run^|build]
exit /b 1"""


def make_folder(path, name):
    folder_path = os.path.join(path, name)
    if not os.path.exists(folder_path):
        os.makedirs(folder_path)
    return folder_path

def main(project_name):
    fp = make_folder(os.getcwd(), project_name)
    print(f"[make] Created project folder: {project_name}")
    with open(os.path.join(fp, "main.rain"), "w", encoding="utf-8") as f:
        f.write(main_rain)
    print("[make] Created main.rain")
    with open(os.path.join(fp, "README.txt"), "w", encoding="utf-8") as f:
        f.write(to_write)
    print("[make] Created README.txt")
    with open(os.path.join(fp, "rain.cnf"), "w", encoding="utf-8") as f:
        f.write(rain_cnf)
    print("[make] Created rain.cnf")
    with open(os.path.join(fp, "rain.bat"), "w", encoding="utf-8") as f:
        f.write(rain_bat)
    print("[make] Created rain.bat")
    print(f"[make] Project '{project_name}' setup complete.")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Rain Make Tool")
    parser.add_argument("project_name", help="Name of the project folder to create")
    args = parser.parse_args()
    main(args.project_name)